#!/usr/bin/env bash
# reload-desktop: Safely reloads Quickshell, Hyprland, and Hypridle
set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    _wl=$(ls -t "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n1)
    if [ -n "$_wl" ]; then export WAYLAND_DISPLAY=$(basename "$_wl"); fi
    unset _wl
fi

echo "=== Reloading Desktop Environment ==="

# 1. Reload Hyprland
echo "[1/3] Reloading Hyprland configuration..."
if command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload || true
    echo "  -> Hyprland reloaded."
else
    echo "  -> hyprctl not found."
fi

# 2. Restart Quickshell
echo "[2/3] Restarting Quickshell..."
killall quickshell 2>/dev/null || true
sleep 0.4
nohup quickshell -p "$HOME/.config/quickshell/waybar-island/shell.qml" >/tmp/quickshell.log 2>&1 &
sleep 1
if pgrep -x quickshell >/dev/null; then
    echo "  -> Quickshell running (PID $(pgrep -x quickshell | head -n1))."
else
    echo "  -> [WARNING] Quickshell failed to start. Check /tmp/quickshell.log"
fi

# 3. Restart Hypridle
echo "[3/3] Restarting Hypridle..."
killall hypridle 2>/dev/null || true
sleep 0.2
nohup hypridle >/dev/null 2>&1 &
if pgrep -x hypridle >/dev/null; then
    echo "  -> Hypridle running (PID $(pgrep -x hypridle | head -n1))."
else
    echo "  -> [WARNING] Hypridle failed to start."
fi

echo ""
echo "=== Desktop Reload Complete ==="
