#!/usr/bin/env bash
# capture-ui: Captures screenshots of the status bar, dynamic island, or full screen using grim
set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    _wl=$(ls -t "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n1)
    if [ -n "$_wl" ]; then export WAYLAND_DISPLAY=$(basename "$_wl"); fi
    unset _wl
fi

target="${1:-bar}"
outfile="${2:-/tmp/capture_${target}.png}"

case "$target" in
    bar)
        echo "Capturing top status bar..."
        # Default geometry for 2560x1440 primary top bar
        grim -g "0,0 2560x40" "$outfile"
        ;;
    island)
        echo "Capturing Dynamic Island center area..."
        grim -g "600,0 1360x600" "$outfile"
        ;;
    full)
        echo "Capturing full screen..."
        grim "$outfile"
        ;;
    *)
        echo "Usage: capture-ui [bar|island|full] [output_path.png]"
        exit 1
        ;;
esac

echo "Saved screenshot to: $outfile"
file "$outfile"
