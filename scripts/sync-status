#!/usr/bin/env bash
# sync-status: Compares and synchronizes files between ~/hyprland and ~/.config / ~/.local/bin
set -euo pipefail

REPO_DIR="$HOME/hyprland"
CONFIG_DIR="$HOME/.config"
BIN_DIR="$HOME/.local/bin"

do_sync=0
if [ "${1:-}" = "--sync" ] || [ "${1:-}" = "-s" ]; then
    do_sync=1
fi

echo "=== Hyprland & Desktop Synchronization Status ==="

check_diff() {
    local src="$1"
    local dst="$2"
    local name="$3"

    if [ ! -e "$src" ]; then
        echo "[MISSING IN REPO] $name"
        return
    fi
    if [ ! -e "$dst" ]; then
        echo "[MISSING IN SYSTEM] $name"
        if [ "$do_sync" -eq 1 ]; then
            mkdir -p "$(dirname "$dst")"
            cp -r "$src" "$dst"
            echo "  -> Copied to system."
        fi
        return
    fi

    if diff -q "$src" "$dst" >/dev/null 2>&1; then
        echo "[SYNCED] $name"
    else
        echo "[OUT OF SYNC] $name"
        if [ "$do_sync" -eq 1 ]; then
            cp -r "$src" "$dst"
            echo "  -> Synchronized (Repo -> System)."
        else
            echo "  Run with --sync to copy repo version to system."
        fi
    fi
}

echo ""
echo "--- Quickshell ---"
check_diff "$REPO_DIR/.config/quickshell/waybar-island/BarraWaybar.qml" "$CONFIG_DIR/quickshell/waybar-island/BarraWaybar.qml" "BarraWaybar.qml"
check_diff "$REPO_DIR/.config/quickshell/waybar-island/shell.qml" "$CONFIG_DIR/quickshell/waybar-island/shell.qml" "shell.qml"

echo ""
echo "--- Hyprland & Lock ---"
check_diff "$REPO_DIR/.config/hypr/hypridle.conf" "$CONFIG_DIR/hypr/hypridle.conf" "hypridle.conf"
check_diff "$REPO_DIR/.config/hypr/hyprlock.conf" "$CONFIG_DIR/hypr/hyprlock.conf" "hyprlock.conf"
check_diff "$REPO_DIR/.config/hypr/hyprland.lua" "$CONFIG_DIR/hypr/hyprland.lua" "hyprland.lua"

echo ""
echo "--- Core Helper Binaries ---"
check_diff "$REPO_DIR/.local/bin/battery-info" "$BIN_DIR/battery-info" "battery-info"
check_diff "$REPO_DIR/.local/bin/battery-charge-limit" "$BIN_DIR/battery-charge-limit" "battery-charge-limit"
check_diff "$REPO_DIR/.local/bin/screen-power" "$BIN_DIR/screen-power" "screen-power"
check_diff "$REPO_DIR/.local/bin/rofi-themed" "$BIN_DIR/rofi-themed" "rofi-themed"

echo ""
echo "Done."
